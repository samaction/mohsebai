<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================================================================= -->
    <!-- صلاحيات التطبيق (Permissions)                                      -->
    <!-- ================================================================= -->
    <!-- إمكانية الوصول إلى شبكة الإنترنت لطلب البيانات والاستدعاءات البرمجية -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- استخدام المصادقة البيومترية (البصمة / بصمة الوجه) للأجهزة الحديثة -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- استخدام بصمة الأصبع للأجهزة التي تعمل بإصدارات قديمة (API < 28) -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- ================================================================= -->
    <!-- إعدادات التطبيق الرئيسية (Application Configuration)             -->
    <!-- ================================================================= -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HallCenter"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- ============================================================= -->
        <!-- النشاط الرئيسي للتطبيق (Main Activity)                         -->
        <!-- ============================================================= -->
        <!-- واجهة الدخول الرئيسية للتطبيق -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HallCenter">
            <!-- مرشح القصد (Intent Filter) لتحديد الواجهة كواجهة تشغيل رئيسية في الشاشة الرئيسية -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>